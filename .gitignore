# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# …except Amazon's public RDS CA bundle, which the image needs to verify the database's TLS.
!deploy/aws/rds-global-bundle.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Keep real environment files private; version only the empty/safe template.
.env*
!/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Python bytecode from the .claude skills
__pycache__/

# Agent skills are installed from skills-lock.json (`npx skills add`), like
# dependencies; the bodies are third-party and the .claude entries are symlinks
# into them. The one skill that ships with the repo stays tracked.
/.agents/
/.claude/skills/*
!/.claude/skills/ui-ux-pro-max/

# Terraform: state and private variables stay on the operator's machine
deploy/aws/terraform/.terraform/
deploy/aws/terraform/*.tfstate
deploy/aws/terraform/*.tfstate.*
deploy/aws/terraform/terraform.tfvars
deploy/aws/terraform/.terraform.lock.hcl

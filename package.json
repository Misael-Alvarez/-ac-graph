{
  "name": "diagram-editor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node -e \"const fs = require('node:fs'); fs.cpSync('public', '.next/standalone/public', { recursive: true }); fs.cpSync('.next/static', '.next/standalone/.next/static', { recursive: true });\" && node .next/standalone/server.js",
    "cli": "node bin/ac-graph.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test --project=functional",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "audit:controls": "node scripts/audit-controls.mjs",
    "styles:snapshot": "node scripts/style-snapshot.mjs capture",
    "styles:compare": "node scripts/style-snapshot.mjs compare",
    "styles:match-map": "node scripts/css-match-map.mjs src/app/globals.css",
    "styles:consolidate": "node scripts/consolidate-css.mjs",
    "test:e2e:critical": "playwright test --project=functional e2e/library.spec.ts e2e/editor.spec.ts e2e/code.spec.ts e2e/import.spec.ts e2e/share.spec.ts e2e/ai.spec.ts e2e/versions.spec.ts e2e/persistence.spec.ts e2e/views.spec.ts",
    "mcp": "node bin/ac-graph-mcp.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "idb": "^8.0.3",
    "immer": "^11.1.18",
    "nanoid": "^5.1.16",
    "next": "16.3.3",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "bin": {
    "ac-graph": "./bin/ac-graph.mjs",
    "ac-graph-mcp": "./bin/ac-graph-mcp.mjs"
  }
}

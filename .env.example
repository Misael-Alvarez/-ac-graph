# Safe template only. Never put real credentials in this tracked file.
# AI is optional and disabled when empty. Enabling it can incur provider charges.
# Next.js reads .env.local; Compose accepts shell variables or --env-file .env.local.
ANTHROPIC_API_KEY=

# Docker publishes only on 127.0.0.1; next dev uses 3000 and Playwright uses 3100.
APP_PORT=3080

# PostgreSQL for server mode (see below). In local mode it is not started and
# diagrams live in IndexedDB. Set a unique password privately before the first
# start; the official image refuses to initialise without one.
POSTGRES_PORT=55432
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Observability (both modes). See docs/DOCKER.md, "Logs, metrics and traces".
# ---------------------------------------------------------------------------
# debug | info | warn | error | silent. Default info.
LOG_LEVEL=info
# json (one object per line, the default in production) | pretty (terminal).
LOG_FORMAT=json
# When set, GET /api/metrics requires "Authorization: Bearer <token>".
# Leave empty when the port is only reachable from your own network.
METRICS_TOKEN=
# Traces are exported only when a collector is named, e.g. http://otel-collector:4318.
# OTEL_EXPORTER_OTLP_HEADERS and OTEL_EXPORTER_OTLP_TRACES_ENDPOINT work as usual.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ac-graph

# ---------------------------------------------------------------------------
# Server mode (PostgreSQL persistence + Authentik login + collaboration).
# Off unless DATABASE_URL, OIDC_ISSUER, OIDC_CLIENT_ID and APP_URL are ALL set.
# With compose.server.yaml, DATABASE_URL is derived from POSTGRES_PASSWORD;
# set it here only for `next dev` against a database you run yourself.
# See docs/AUTHENTIK.md. Never commit real values.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://acgraph:<password>@127.0.0.1:55432/acgraph
# Authentik provider issuer, with the trailing slash exactly as Authentik shows it.
# OIDC_ISSUER=https://auth.example.com/application/o/ac-graph/
# OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only); set for a confidential client.
# OIDC_CLIENT_SECRET=
# The origin the browser uses; the callback is ${APP_URL}/api/auth/callback.
# APP_URL=http://localhost:3080
# SESSION_TTL_HOURS=12
# PGPOOL_MAX=10
